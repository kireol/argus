<?xml version="1.0" encoding="utf-8"?>
<!--
    Fixed-dp layout designed for a 1080x1920 portrait device at xxhdpi
    (density 3.0, i.e. a 360x640dp surface). Coordinates below map to the
    exact pixel positions documented in README.md's "Tap coordinates" table.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Home screen: title, counter, "+" button, Settings button, colour swatch. -->
    <FrameLayout
        android:id="@+id/home_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="80dp"
            android:text="@string/app_title"
            android:textColor="@android:color/black"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="160dp"
            android:text="Count: 0"
            android:textColor="@android:color/black"
            android:textSize="28sp" />

        <!-- Colour swatch: centred on px (900,300) -> dp (300,100). -->
        <View
            android:id="@+id/viewSwatch"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="240dp"
            android:layout_marginTop="40dp"
            android:background="#2ecc71" />

        <!-- "+" button: centred on px (540,1000) -> dp (180,333.33). -->
        <Button
            android:id="@+id/btnPlus"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="120dp"
            android:layout_marginTop="273.33dp"
            android:text="@string/label_plus"
            android:textSize="32sp" />

        <!-- Settings button: centred on px (540,1250) -> dp (180,416.67). -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="200dp"
            android:layout_height="80dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="80dp"
            android:layout_marginTop="376.67dp"
            android:text="@string/label_settings" />

    </FrameLayout>

    <!-- Settings screen: title, dark-theme toggle, Back button. -->
    <FrameLayout
        android:id="@+id/settings_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="80dp"
            android:text="@string/label_settings"
            android:textColor="@android:color/black"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Dark theme switch: centred on px (540,700) -> dp (180,233.33). -->
        <Switch
            android:id="@+id/switchDark"
            android:layout_width="240dp"
            android:layout_height="60dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="60dp"
            android:layout_marginTop="203.33dp"
            android:text="@string/label_dark_theme"
            android:textColor="@android:color/black" />

        <!-- Back button: centred on px (540,1250) -> dp (180,416.67). -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="200dp"
            android:layout_height="80dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="80dp"
            android:layout_marginTop="376.67dp"
            android:text="@string/label_back" />

    </FrameLayout>

</FrameLayout>
